# =====================================================
# MYSQL ROOT (digunakan oleh container MySQL)
# =====================================================
MYSQL_ROOT_PASSWORD=change_me

# =====================================================
# AUTH DATABASE
# =====================================================
MYSQL_AUTH_DB=dbuser
MYSQL_AUTH_USER=authuser
MYSQL_AUTH_PASSWORD=change_me
MYSQL_AUTH_PORT=3307

# =====================================================
# ORDER DATABASE
# =====================================================
MYSQL_ORDER_DB=dborder
MYSQL_ORDER_USER=orderuser
MYSQL_ORDER_PASSWORD=change_me
MYSQL_ORDER_PORT=3308

# =====================================================
# PRODUCT DATABASE
# =====================================================
MYSQL_PRODUCT_DB=dbproduct
MYSQL_PRODUCT_USER=productuser
MYSQL_PRODUCT_PASSWORD=change_me
MYSQL_PRODUCT_PORT=3309

# =====================================================
# CUSTOMER DATABASE
# =====================================================
MYSQL_CUSTOMER_DB=dbcustomer
MYSQL_CUSTOMER_USER=customeruser
MYSQL_CUSTOMER_PASSWORD=change_me
MYSQL_CUSTOMER_PORT=3310

# =====================================================
# SERVICE PORTS
# =====================================================
AUTH_SERVICE_PORT=8099
ORDER_SERVICE_PORT=8083
PRODUCT_SERVICE_PORT=8082
CUSTOMER_SERVICE_PORT=8081
CONFIG_SERVER_PORT=8088
REGISTRY_SERVICE_PORT=8761
API_GATEWAY_PORT=80
ZIPKIN_PORT=9411

# =====================================================
# SPRING
# =====================================================
SPRING_PROFILES_ACTIVE=docker

# =====================================================
# JWT (HARUS SAMA di auth-service & api-gateway)
# Generate dengan: openssl rand -base64 64
# =====================================================
JWT_SECRET=change_me_base64
JWT_EXPIRATION=3600000
